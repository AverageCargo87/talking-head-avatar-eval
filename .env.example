# Nothing here is needed for the metrics, the tests or the demos. Only the paid or GPU paths use it.

# prerender/anam_render.py (cloud avatar prerender)
ANAM_API_KEY=your-anam-api-key

# prerender/make-teacher-clips.mjs: any endpoint that turns {"text","voice","speed"} into audio
TTS_URL=http://localhost:PORT/api/tts
TTS_VOICE=your-voice-name
TTS_SPEED=0.95
# optional: replace the ffmpeg stub with a real lip-sync engine
# LIPSYNC_CMD=python prerender/lipsync_run.py --face {face} --audio {audio} --out {out}
# LIPSYNC_BATCH_CMD=python prerender/lipsync_batch.py --jobs {jobs} --face {face}

# prerender/lipsync_*.py and local/syncnet_offset.sh
LATENTSYNC_DIR=/path/to/LatentSync
LATENTSYNC_PYTHON=/path/to/latentsync-venv/bin/python

# runner/bithuman_runner.py (real avatar runner)
BITHUMAN_API_SECRET=your-bithuman-secret
BITHUMAN_MODEL_DIR=/path/to/models
RUNNER_HOST=localhost
RUNNER_PORT=8090

# runner/mock-runner.mjs
MOCK_HOST=localhost
MOCK_PORT=8090

# local/comfy_infinitetalk.py
COMFY_URL=http://localhost:8188
COMFY_INPUT=/path/to/ComfyUI/input
